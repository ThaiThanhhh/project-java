 document.close();
 document.addEventListener('keydown', (e) => {
   if (e.keyCode === 80 /* P */ && !e.shiftKey && e.altKey && ${s.Ay.mac?"!e.ctrlKey && e.metaKey":"e.ctrlKey && !e.metaKey"}) {
     // Handle the plugin re-run shortcut
     window.parent.postMessage('${h.IN}', '*')
     e.stopPropagation()
     e.stopImmediatePropagation()
   } else if (${JSON.stringify(E)}) {
     // Handle Select All, Undo and Redo in the desktop app
     const ctrlDown = ${s.Ay.mac?"e.metaKey":"e.ctrlKey"}
     if (ctrlDown) {
       if (e.keyCode === 65 /* A */) {
         document.execCommand('selectAll')
       } else if (e.keyCode === 90 /* Z */) {
         if (e.shiftKey) {
           document.execCommand('redo')
         } else {
           document.execCommand('undo')
         }
       } else if ((e.key === 'x' || e.key === 'X') && ${JSON.stringify((0,p.T)())}) {
         document.execCommand('cut')
       } else if ((e.key === 'c' || e.key === 'C') && ${JSON.stringify((0,p.T)())}) {
